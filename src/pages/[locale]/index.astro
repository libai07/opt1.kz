---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { q } from '../../db/queries';

const locale = (Astro.params.locale as 'ru' | 'kk' | 'zh') || 'ru';
Astro.locals.locale = locale;
const env = Astro.locals.runtime.env;
const t = Astro.locals.t;

const url = new URL(Astro.request.url);
const categorySlug = url.searchParams.get('category') || undefined;

let categories: any[] = [];
let products: any[] = [];
let settings: Record<string, string> = {};
try {
  [categories, products, settings] = await Promise.all([
    q(env.DB).listCategories(true),
    q(env.DB).listProducts({ locale, categorySlug, activeOnly: true, limit: 12 }),
    q(env.DB).getSettings(),
  ]);
} catch (e) {
  console.error('Home page data error', e);
}

const wa = settings.whatsapp_number || env.WHATSAPP_NUMBER || '+77000000000';
const tiktok = settings.tiktok_url || env.TIKTOK_URL || 'https://tiktok.com/@opt1.kz';
const instagram = settings.instagram_url || env.INSTAGRAM_URL || 'https://instagram.com/opt1.kz';
const waPhone = wa.replace(/[^\d]/g, '');
---
<Layout title={t('hero.title').replace(/<[^>]*>/g, '') + ' — Opt1 KZ'}>
  <section class="hero">
    <div class="container-app hero-grid">
      <div class="hero-main">
        <div class="eyebrow"><span class="dot"></span> {t('hero.badge')}</div>
        <h1 set:html={t('hero.title')} />
        <p>{t('hero.subtitle')}</p>
        <div class="hero-actions">
          <a href="#catalog" class="btn btn-primary">{t('hero.cta')}</a>
          <a href={`https://wa.me/${waPhone}`} target="_blank" rel="noopener" class="btn btn-ghost">{t('hero.whatsapp')}</a>
        </div>
        <div class="hero-stats">
          <div class="stat"><strong>{t('hero.stat1.value')}</strong><span>{t('hero.stat1.label')}</span></div>
          <div class="stat"><strong>{t('hero.stat2.value')}</strong><span>{t('hero.stat2.label')}</span></div>
          <div class="stat"><strong>{t('hero.stat3.value')}</strong><span>{t('hero.stat3.label')}</span></div>
        </div>
      </div>
      <div class="hero-side">
        <div class="side-card dark">
          <div class="side-label">⚡ Мы в соцсетях</div>
          <h3>{t('social.title')}</h3>
          <p>{t('social.subtitle')}</p>
          <div class="social-cards">
            <a href={tiktok} target="_blank" rel="noopener" class="social-card">
              <div class="social-icon tiktok"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 7.5a4.5 4.5 0 01-3.36-1.52A4.48 4.48 0 0114.5 3h-2.9v11.2a2.3 2.3 0 11-2.3-2.3c.25 0 .5.04.73.11V9.05a5.2 5.2 0 00-.73-.05 5.2 5.2 0 105.2 5.2V8.34a7.35 7.35 0 004.5 1.52V7.5z"/></svg></div>
              <div><span>TikTok</span><strong>@opt1.kz</strong></div>
            </a>
            <a href={instagram} target="_blank" rel="noopener" class="social-card">
              <div class="social-icon insta"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7.5 2h9A5.5 5.5 0 0122 7.5v9a5.5 5.5 0 01-5.5 5.5h-9A5.5 5.5 0 012 16.5v-9A5.5 5.5 0 017.5 2zm0 2A3.5 3.5 0 004 7.5v9A3.5 3.5 0 007.5 20h9a3.5 3.5 0 003.5-3.5v-9A3.5 3.5 0 0016.5 4h-9zm10 1.5a1 1 0 110 2 1 1 0 010-2zM12 7a5 5 0 110 10 5 5 0 010-10zm0 2a3 3 0 100 6 3 3 0 000-6z"/></svg></div>
              <div><span>Instagram</span><strong>@opt1.kz</strong></div>
            </a>
          </div>
        </div>
        <div class="side-card">
          <div class="side-label" style="color:#1A73E8">✓ {t('trust.title')}</div>
          <div class="trust-list">
            <div class="trust-item"><div class="ic">💳</div><span>{t('trust.1')}</span></div>
            <div class="trust-item"><div class="ic">📦</div><span>{t('trust.2')}</span></div>
            <div class="trust-item"><div class="ic">🚚</div><span>{t('trust.3')}</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-app">
      <div class="section-head"><div><h2>{t('categories.title')}</h2><p>{t('categories.subtitle')}</p></div></div>
      <div class="cats">
        <a href={`/${locale}/`} class:list={['cat', { active: !categorySlug }]}><span class="emoji">🔥</span> {t('categories.all')}</a>
        {categories.map(c => (
          <a href={`/${locale}/category/${c.slug}/`} class:list={['cat', { active: categorySlug === c.slug }]}>
            <span class="emoji">{c.icon || '📦'}</span> {c[`name_${locale}`] || c.name_ru}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="catalog">
    <div class="container-app">
      <div class="section-head">
        <div><h2>{t('products.title')}</h2><p>{t('products.subtitle')}</p></div>
      </div>
      {products.length > 0 ? (
        <div class="products-grid">
          {products.map(p => <ProductCard product={p} locale={locale} />)}
        </div>
      ) : (
        <div class="empty-state"><div class="empty-icon">📦</div><h3>{t('products.empty')}</h3><p>{t('products.empty_hint')}</p></div>
      )}
      <div class="banner">
        <div>
          <h3>{t('banner.title')}</h3>
          <p>{t('banner.subtitle')}</p>
        </div>
        <div class="banner-actions">
          <a href={`https://wa.me/${waPhone}`} target="_blank" rel="noopener" class="btn btn-wa">{t('banner.cta')}</a>
          <a href={tiktok} target="_blank" rel="noopener" class="btn btn-ghost">{t('banner.tiktok')}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero{padding:28px 0 0}
  .hero-grid{display:grid;grid-template-columns:1.45fr 1fr;gap:20px}
  .hero-main{position:relative;overflow:hidden;border-radius:28px;min-height:460px;background:linear-gradient(120deg,#0F172A 0%,#1E3A5F 45%,#1A73E8 130%);color:#fff;padding:52px;display:flex;flex-direction:column;justify-content:flex-end}
  .hero-main::before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 60% 60% at 75% 30%,rgba(77,163,255,.35),transparent 70%)}
  .hero-main > *{position:relative}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;width:fit-content;padding:8px 14px;border-radius:999px;background:rgba(255,255,255,.12);font-size:13px;font-weight:700;margin-bottom:24px}
  .dot{width:8px;height:8px;background:#4ADE80;border-radius:50%;box-shadow:0 0 0 4px rgba(74,222,128,.2)}
  .hero h1{font-size:clamp(36px,5vw,56px);line-height:1.05;letter-spacing:-.035em;font-weight:800;max-width:700px;margin:0 0 18px}
  .hero h1 :global(.accent){color:#7DD3FC}
  .hero p{font-size:17px;color:#d5e2f0;max-width:560px;margin:0 0 30px;line-height:1.65}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:34px}
  .btn-ghost{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.2);display:inline-flex;align-items:center;justify-content:center;height:48px;padding:0 20px;border-radius:14px;font-weight:700;font-size:14px;text-decoration:none}
  .btn-ghost:hover{background:rgba(255,255,255,.18)}
  .hero .btn-primary{background:#fff;color:#111827;box-shadow:0 8px 24px rgba(0,0,0,.15)}
  .hero .btn-primary:hover{background:#f0f4f8}
  .hero-stats{display:flex;gap:28px;flex-wrap:wrap;padding-top:28px;border-top:1px solid rgba(255,255,255,.12)}
  .stat{display:flex;flex-direction:column;gap:2px}.stat strong{font-size:22px;font-weight:800}.stat span{font-size:13px;color:#b8cce0}
  .hero-side{display:flex;flex-direction:column;gap:20px}
  .side-card{background:#fff;border-radius:24px;padding:28px;border:1px solid #E5E9EF;flex:1;display:flex;flex-direction:column}
  .side-card.dark{background:linear-gradient(160deg,#FFF7F3 0%,#FFF 100%);border-color:#ffe3d6}
  .side-label{font-size:12px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#FF5A1F;margin-bottom:14px}
  .side-card h3{font-size:24px;line-height:1.25;letter-spacing:-.02em;margin:0 0 10px;font-weight:800}
  .side-card p{color:#667085;font-size:14px;line-height:1.65;margin:0 0 20px}
  .social-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:auto}
  .social-card{display:flex;align-items:center;gap:12px;padding:14px;border-radius:16px;background:#fff;border:1px solid #E5E9EF;text-decoration:none;color:inherit}
  .social-card:hover{transform:translateY(-2px);box-shadow:0 8px 30px rgba(16,24,40,.06)}
  .social-icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;color:#fff}
  .social-icon svg{width:22px;height:22px}
  .social-icon.tiktok{background:#111}.social-icon.insta{background:linear-gradient(135deg,#F58529,#DD2A7B,#8134AF)}
  .social-card span{display:block;font-size:12px;color:#667085}.social-card strong{font-size:14px;font-weight:700}
  .trust-list{display:flex;flex-direction:column;gap:12px;margin-top:auto}
  .trust-item{display:flex;align-items:center;gap:12px;font-size:14px;font-weight:600;color:#344054}
  .trust-item .ic{width:34px;height:34px;border-radius:10px;background:#EEF4FF;display:grid;place-items:center;flex:0 0 auto;font-size:16px}
  .section{padding:56px 0 0}
  .section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
  .section-head h2{font-size:clamp(26px,3vw,36px);line-height:1.15;letter-spacing:-.03em;font-weight:800;margin:0}
  .section-head p{color:#667085;margin:6px 0 0;font-size:15px}
  .cats{display:flex;gap:10px;overflow-x:auto;padding-bottom:4px;scrollbar-width:none}
  .cats::-webkit-scrollbar{display:none}
  .cat{display:inline-flex;align-items:center;gap:10px;padding:10px 18px 10px 10px;background:#fff;border:1px solid #E5E9EF;border-radius:14px;font-size:14px;font-weight:700;white-space:nowrap;color:#344054;text-decoration:none}
  .cat:hover{border-color:#c5d7ee;color:#1A73E8}.cat.active{background:#111827;color:#fff;border-color:#111827}
  .cat .emoji{width:36px;height:36px;border-radius:10px;background:#F0F3F6;display:grid;place-items:center;font-size:18px}
  .cat.active .emoji{background:rgba(255,255,255,.15)}
  .products-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .empty-state{text-align:center;padding:56px 20px;background:#fff;border:1px solid #E5E9EF;border-radius:20px}
  .empty-icon{font-size:56px;margin-bottom:12px}.empty-state h3{margin:0 0 8px;font-size:22px}.empty-state p{color:#667085;margin:0}
  .banner{margin-top:56px;padding:36px 40px;border-radius:24px;background:linear-gradient(135deg,#111827,#1F2937);color:#fff;display:flex;align-items:center;justify-content:space-between;gap:24px}
  .banner h3{font-size:28px;font-weight:800;margin:0 0 6px}.banner p{color:#B8C5D6;margin:0;font-size:15px}
  .banner-actions{display:flex;gap:12px;flex-wrap:wrap}
  @media(max-width:1024px){.hero-grid{grid-template-columns:1fr}.hero-side{flex-direction:row}.products-grid{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:760px){.hero{padding-top:16px}.hero-main{padding:32px 24px;min-height:400px;border-radius:24px}.hero p{font-size:15px}.hero-side{flex-direction:column}.side-card{padding:22px}.section{padding:40px 0 0}.products-grid{grid-template-columns:repeat(2,1fr);gap:12px}.banner{flex-direction:column;align-items:flex-start;padding:28px 24px}.banner h3{font-size:24px}}
</style>
