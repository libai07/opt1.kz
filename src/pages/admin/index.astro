---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="ru">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Админка — Opt1 KZ</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700;800&display=swap" rel="stylesheet"></head>
<body style="margin:0;background:#F6F7F9;font-family:Manrope,system-ui,sans-serif;color:#18212B">
  <div style="max-width:1200px;margin:0 auto;padding:24px">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:24px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:10px"><div style="width:42px;height:42px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,#1A73E8,#4DA3FF);color:#fff;font-weight:800">O1</div><div><div style="font-size:22px;font-weight:800">Opt1 KZ Admin</div><div id="admin-email" style="font-size:13px;color:#667085"></div></div></div>
      <button id="logout" class="btn btn-outline" style="height:42px">Выйти</button>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:24px">
      <div class="stat-card"><div class="label">Новые</div><div class="val" id="s-pending">-</div></div>
      <div class="stat-card"><div class="label">Счёт отправлен</div><div class="val" id="s-invoiced">-</div></div>
      <div class="stat-card"><div class="label">Оплачено</div><div class="val" id="s-paid">-</div></div>
      <div class="stat-card"><div class="label">Отправлено</div><div class="val" id="s-shipped">-</div></div>
    </div>
    <div style="background:#fff;border:1px solid #E5E9EF;border-radius:20px;padding:20px;overflow:auto">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:16px;flex-wrap:wrap">
        <h2 style="margin:0;font-size:20px;font-weight:800">Заказы</h2>
        <div style="display:flex;gap:8px"><input id="phone-filter" class="field" placeholder="Поиск по телефону" style="height:42px;width:220px"><button id="refresh" class="btn btn-primary" style="height:42px">Обновить</button></div>
      </div>
      <table style="width:100%;border-collapse:collapse;font-size:14px">
        <thead><tr style="text-align:left;color:#667085"><th style="padding:10px;border-bottom:1px solid #E5E9EF">ID</th><th style="padding:10px;border-bottom:1px solid #E5E9EF">Товар</th><th style="padding:10px;border-bottom:1px solid #E5E9EF">Клиент</th><th style="padding:10px;border-bottom:1px solid #E5E9EF">Телефон</th><th style="padding:10px;border-bottom:1px solid #E5E9EF">Статус</th><th style="padding:10px;border-bottom:1px solid #E5E9EF">Действия</th></tr></thead>
        <tbody id="orders-body"></tbody>
      </table>
    </div>
  </div>
  <style>.stat-card{background:#fff;border:1px solid #E5E9EF;border-radius:16px;padding:20px}.stat-card .label{font-size:13px;color:#667085;font-weight:700;margin-bottom:6px}.stat-card .val{font-size:30px;font-weight:800;color:#111827} .pill{display:inline-block;padding:4px 10px;border-radius:999px;font-size:12px;font-weight:700;background:#F0F3F6;color:#344054} .actions button{margin:2px;padding:6px 10px;border-radius:8px;border:1px solid #E5E9EF;background:#fff;font:inherit;font-size:12px;font-weight:700;cursor:pointer}.actions button:hover{border-color:#cfd8e3}</style>
  <script>
    const token = localStorage.getItem('opt1_token');
    if (!token) location.href = '/admin/login';
    const h: Record<string, string> = { 'Content-Type':'application/json', 'Authorization': 'Bearer ' + token };
    async function api(path: string, opts: RequestInit = {}) {
      const r = await fetch(path, { ...opts, headers: { ...h, ...(opts.headers as any || {}) } });
      if (r.status === 401) { localStorage.removeItem('opt1_token'); location.href = '/admin/login'; }
      return r.json() as Promise<any>;
    }
    async function load() {
      const phoneInput = document.getElementById('phone-filter') as HTMLInputElement | null;
      const phone = phoneInput?.value.trim() || '';
      const data = await api('/api/admin/orders' + (phone ? '?phone=' + encodeURIComponent(phone) : ''));
      const orders = data.orders || [];
      const stats: Record<string, number> = {pending:0,invoiced:0,paid:0,shipped:0};
      for (const o of orders) stats[o.status] = (stats[o.status] || 0) + 1;
      for (const k of ['pending','invoiced','paid','shipped']) {
        const el = document.getElementById('s-' + k);
        if (el) el.textContent = String(stats[k] || 0);
      }
      const bodyEl = document.getElementById('orders-body');
      if (!bodyEl) return;
      bodyEl.innerHTML = orders.map((o: any) => `<tr>
        <td style="padding:10px;border-bottom:1px solid #F0F3F6;font-weight:700">${o.id}</td>
        <td style="padding:10px;border-bottom:1px solid #F0F3F6">${o.title_ru || ''} × ${o.qty}</td>
        <td style="padding:10px;border-bottom:1px solid #F0F3F6">${o.buyer_name}<br><small style="color:#667085">${o.city}</small></td>
        <td style="padding:10px;border-bottom:1px solid #F0F3F6">${o.buyer_phone}</td>
        <td style="padding:10px;border-bottom:1px solid #F0F3F6"><span class="pill">${o.status}</span></td>
        <td style="padding:10px;border-bottom:1px solid #F0F3F6" class="actions">
          <button onclick="act('${o.id}','invoice')">Счёт</button>
          <button onclick="act('${o.id}','paid')">Оплачен</button>
          <button onclick="act('${o.id}','ship')">Отправлен</button>
          <button onclick="act('${o.id}','cancel')">Отмена</button>
        </td></tr>`).join('') || '<tr><td colspan="6" style="padding:20px;color:#667085">Нет заказов</td></tr>';
    }
    (window as any).act = async (id: string, action: string) => { await api('/api/admin/orders', { method:'POST', body: JSON.stringify({id, action}) }); load(); };
    document.getElementById('refresh')?.addEventListener('click', load);
    document.getElementById('logout')?.addEventListener('click', () => { localStorage.removeItem('opt1_token'); location.href='/admin/login'; });
    api('/api/admin/auth', { method:'POST', body:'{}' }).then(d => { const el = document.getElementById('admin-email'); if (d.admin && el) el.textContent = d.admin.email; });
    load();
  </script>
</body>
</html>
