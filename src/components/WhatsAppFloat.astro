---
interface Props { wa: string }
const { wa } = Astro.props;
const phone = wa.replace(/[^\d]/g, '');
---
<a href={`https://wa.me/${phone}`} class="wa-float" target="_blank" rel="noopener" aria-label="WhatsApp">
  <span class="wa-tip">Написать нам</span>
  <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M12 2a10 10 0 00-8.66 15l-1.2 4.38 4.49-1.18A10 10 0 1012 2zm0 18.2a8.18 8.18 0 01-4.17-1.14l-.3-.18-2.66.7.71-2.6-.2-.31A8.2 8.2 0 1112 20.2zm4.5-6.14c-.24-.12-1.45-.72-1.67-.8-.23-.08-.39-.12-.55.12-.17.25-.64.8-.78.96-.14.17-.29.19-.53.07-.25-.13-1.04-.39-1.98-1.23-.73-.65-1.23-1.46-1.37-1.7-.15-.25-.02-.38.1-.5.12-.11.25-.29.37-.43.12-.15.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.13-.55-1.33-.76-1.82-.2-.48-.4-.41-.55-.42h-.47c-.17 0-.43.06-.66.31-.22.25-.86.84-.86 2.05 0 1.21.88 2.38 1 2.54.13.17 1.74 2.66 4.22 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.55.1.48-.07 1.45-.59 1.66-1.16.2-.57.2-1.06.14-1.16-.06-.1-.22-.16-.47-.28z"/></svg>
</a>
<style>
  .wa-float{position:fixed;bottom:24px;right:24px;z-index:100;width:58px;height:58px;border-radius:50%;background:#25D366;color:#fff;display:grid;place-items:center;box-shadow:0 8px 24px rgba(37,211,102,.4);transition:.2s}
  .wa-float:hover{transform:scale(1.06);background:#1fb859}
  .wa-tip{position:absolute;right:70px;background:#fff;color:#18212B;padding:10px 14px;border-radius:12px;font-size:13px;font-weight:700;white-space:nowrap;box-shadow:0 8px 30px rgba(16,24,40,.06);border:1px solid #E5E9EF}
  .wa-tip::after{content:"";position:absolute;right:-5px;top:50%;margin-top:-5px;width:10px;height:10px;background:#fff;border-right:1px solid #E5E9EF;border-top:1px solid #E5E9EF;transform:rotate(45deg)}
  @media(max-width:760px){.wa-float{bottom:16px;right:16px;width:54px;height:54px}.wa-tip{display:none}}
</style>
