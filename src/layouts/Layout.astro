---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { q } from '../db/queries';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Opt1 KZ — Оптовые цены от 1 шт. Доставка по Казахстану. Оплата через Kaspi.' } = Astro.props;
const locale = Astro.locals.locale;
const env = Astro.locals.runtime.env;
let settings: Record<string, string> = {};
let categories: any[] = [];
try {
  [settings, categories] = await Promise.all([q(env.DB).getSettings(), q(env.DB).listCategories(true)]);
} catch { /* allow render in preview without DB */ }

const wa = settings.whatsapp_number || env.WHATSAPP_NUMBER || '+77000000000';
const tiktok = settings.tiktok_url || env.TIKTOK_URL || 'https://tiktok.com/@opt1.kz';
const instagram = settings.instagram_url || env.INSTAGRAM_URL || 'https://instagram.com/opt1.kz';
---
<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Header locale={locale} categories={categories} wa={wa} tiktok={tiktok} instagram={instagram} />
  <slot />
  <Footer locale={locale} categories={categories} wa={wa} tiktok={tiktok} instagram={instagram} settings={settings} />
  <WhatsAppFloat wa={wa} />
</body>
</html>
