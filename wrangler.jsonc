{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opt1kz",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SITE_URL": "https://shop.opt1.kz",
    "WHATSAPP_NUMBER": "+77000000000",
    "TIKTOK_URL": "https://tiktok.com/@opt1.kz",
    "INSTAGRAM_URL": "https://instagram.com/opt1.kz",
    "SITE_NAME": "Opt1 KZ",
    "DEFAULT_LOCALE": "ru",
    "SUPPORTED_LOCALES": "ru,kk,zh"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opt1kz-db",
      "database_id": "YOUR_D1_DATABASE_ID",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "opt1kz-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
