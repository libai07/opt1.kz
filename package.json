{
  "name": "opt1kz",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute opt1kz-db --local --file=./src/db/migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute opt1kz-db --remote --file=./src/db/migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute opt1kz-db --local --file=./src/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute opt1kz-db --remote --file=./src/db/seed.sql",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "hono": "^4.7.0",
    "jose": "^5.9.0",
    "tailwindcss": "^4.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.0.0",
    "astro": "^5.7.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
